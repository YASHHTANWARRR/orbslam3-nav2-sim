  <version>0.1.0</version>
  <description>Top-level bringup for the monocular ORB-SLAM3 TurtleBot3 simulation.</description>
  <maintainer email="yashtanwar11092005@gmail.com">hornet</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>vslam_simulator</exec_depend>
