<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vslam_slam</name>
  <version>0.1.0</version>
  <description>Monocular ORB-SLAM3 node and settings for the simulated TurtleBot3.</description>
  <maintainer email="yashtanwar11092005@gmail.com">hornet</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>cv_bridge</depend>

  <!-- Headers and liborb_slam3_lib.so come from this package, but it exports
       no ament target, so CMakeLists locates it by path instead. -->
  <exec_depend>ros2_orb_slam3</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
