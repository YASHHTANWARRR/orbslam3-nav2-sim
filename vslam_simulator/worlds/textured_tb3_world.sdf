    <model name="block_1">
      <static>true</static>
      <pose>-2.0 1.8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.35 0.35 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.35 0.7</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>../materials/textures/pillar_2.png</albedo_map>
