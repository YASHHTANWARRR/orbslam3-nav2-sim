              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_2">
      <static>true</static>
      <pose>2.0 -1.8 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 1.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 1.1</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
