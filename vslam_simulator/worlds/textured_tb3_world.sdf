    </model>

    <model name="block_3">
      <static>true</static>
      <pose>-2.0 -1.9 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.25 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.25 0.9</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
