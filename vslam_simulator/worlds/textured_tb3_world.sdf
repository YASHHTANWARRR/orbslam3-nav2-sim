    </model>

    <model name="block_4">
      <static>true</static>
      <pose>1.9 2.0 0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 0.4 1.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 0.4 1.3</size></box></geometry>
          <material>
